# Copy to .env (never commit .env). All values are optional.

# Identify yourself to OpenStreetMap Nominatim (their usage policy asks for this).
# NOMINATIM_USER_AGENT=CropRecommendationApp/1.0 (you@example.com)

# Output of the regional data pipeline. Default: dataset_pipeline/output/india_crop_dataset.csv
# REGIONAL_DATASET_PATH=dataset_pipeline/output/india_crop_dataset.csv

# Where the on-disk geocoding cache lives (default: ./cache)
# CACHE_DIR=cache

# --- Agricultural RAG assistant ---
# ANTHROPIC_API_KEY=your-key-here
# RAG_LLM_MODEL=claude-sonnet-5-5
# RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
# RAG_MIN_SCORE=0.45
# RAG_TOP_K=5
# RAG_DOCS_DIR=rag/documents
# RAG_INDEX_DIR=rag/index

# --- Decision agent (weather tool) ---
# OPENWEATHER_API_KEY=your-openweathermap-key
